# Copia este archivo a .env (no se versiona) y ajusta los valores. Nunca subas credenciales reales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crediya_auth
DB_USERNAME=crediya
DB_PASSWORD=cambia-esta-clave
SERVER_PORT=8080

# --- HU3: seguridad ---
# Clave privada RSA para firmar los JWT (base64 de PKCS8). Generala con ./scripts/generate-jwt-key.sh.
# Si se deja vacia se genera una clave efimera al arrancar (solo desarrollo).
JWT_PRIVATE_KEY=
JWT_TTL_MINUTES=60
# Primer administrador (solo se crea si la clave esta definida y no existe ningun ADMIN)
BOOTSTRAP_ADMIN_EMAIL=admin@crediya.local
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave-admin
BOOTSTRAP_ADMIN_DOCUMENTO=0000000001
